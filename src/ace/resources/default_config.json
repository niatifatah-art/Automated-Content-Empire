{
  "schema_version": 4,
  "active_profile": null,
  "content_language": "English",
  "default_audience": "General audience",
  "default_tone": "Clear, engaging, and natural",
  "providers": {
    "gemini": {
      "type": "gemini",
      "enabled": true,
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "api_key_env": "GEMINI_API_KEY",
      "requires_api_key": true,
      "timeout_seconds": 180,
      "paid": true
    },
    "ollama": {
      "type": "ollama",
      "enabled": true,
      "base_url": "http://127.0.0.1:11434",
      "timeout_seconds": 600,
      "paid": false
    },
    "openai": {
      "type": "openai_compatible",
      "enabled": false,
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "requires_api_key": true,
      "api_mode": "responses",
      "timeout_seconds": 180,
      "paid": true
    },
    "openrouter": {
      "type": "openai_compatible",
      "enabled": false,
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "requires_api_key": true,
      "api_mode": "chat",
      "timeout_seconds": 180,
      "paid": true
    },
    "lmstudio": {
      "type": "openai_compatible",
      "enabled": false,
      "base_url": "http://127.0.0.1:1234/v1",
      "requires_api_key": false,
      "api_mode": "chat",
      "timeout_seconds": 600,
      "paid": false
    },
    "vllm": {
      "type": "openai_compatible",
      "enabled": false,
      "base_url": "http://127.0.0.1:8000/v1",
      "requires_api_key": false,
      "api_mode": "chat",
      "timeout_seconds": 600,
      "paid": false
    },
    "anthropic": {
      "type": "anthropic",
      "enabled": false,
      "base_url": "https://api.anthropic.com/v1",
      "api_key_env": "ANTHROPIC_API_KEY",
      "requires_api_key": true,
      "timeout_seconds": 180,
      "paid": true
    }
  },
  "routes": {
    "default": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "research": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "idea": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "writing": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "script": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "review": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "selection": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "planning": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "prompt": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "translation": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "json": [
      {
        "provider": "ollama",
        "model": "auto-small"
      },
      {
        "provider": "gemini",
        "model": "gemini-3.5-flash-lite"
      }
    ],
    "asset_tagging": [
      {
        "provider": "ollama",
        "model": "auto-small"
      },
      {
        "provider": "gemini",
        "model": "gemini-3.5-flash-lite"
      }
    ],
    "profile": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "quality": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "fact_check": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ],
    "tts": [
      {
        "provider": "gemini",
        "model": "gemini-3.6-flash"
      },
      {
        "provider": "ollama",
        "model": "auto"
      }
    ]
  },
  "generation": {
    "temperature": 0.7,
    "max_output_tokens": 4096,
    "variants": 5,
    "selection_mode": "hybrid",
    "review_by_default": true,
    "ask_for_extras": true,
    "minimum_quality_score": 85,
    "maximum_retries": 3,
    "fact_check_factual_content": true,
    "create_tts_ready_script": true
  },
  "memory": {
    "mode": "smart",
    "smart_keep_alive": "5m",
    "unload_at_pipeline_end": true,
    "unload_on_error": true,
    "maximum_loaded_local_models": 1
  },
  "execution": {
    "strategy": "best_available",
    "prefer_free": true,
    "allow_paid": true,
    "confirm_estimated_cost_above_usd": 1.0,
    "skip_optional_unavailable_steps": true,
    "never_use_unlicensed_assets": true
  },
  "languages": {
    "default": "en",
    "enabled": [
      "en",
      "fr",
      "ar"
    ],
    "arabic_style": "neutral_mashriqi_social",
    "arabic_fallback": "spoken_modern_standard"
  },
  "storage": {
    "default_format": "markdown",
    "write_metadata": true,
    "cleanup_mode": "automatic",
    "temporary_retention_days": 7,
    "rejected_candidates_retention_days": 7,
    "warning_free_space_gb": 20,
    "stop_downloads_free_space_gb": 10,
    "cache_limit_gb": 15
  },
  "resources": {
    "automatic": true,
    "license_policy": "strict",
    "download_limit_per_generation": 8,
    "allowed_licenses": [
      "user_owned",
      "public_domain",
      "cc0",
      "cc_by",
      "pexels",
      "pixabay",
      "unsplash"
    ],
    "blocked_licenses": [
      "unknown",
      "all_rights_reserved",
      "noncommercial",
      "no_derivatives"
    ],
    "providers": {
      "library": {
        "enabled": true
      },
      "wikimedia": {
        "enabled": true
      },
      "openverse": {
        "enabled": true,
        "api_key_env": "OPENVERSE_ACCESS_TOKEN"
      },
      "pexels": {
        "enabled": true,
        "api_key_env": "PEXELS_API_KEY"
      },
      "pixabay": {
        "enabled": true,
        "api_key_env": "PIXABAY_API_KEY"
      },
      "unsplash": {
        "enabled": false,
        "api_key_env": "UNSPLASH_ACCESS_KEY"
      },
      "generated_graphics": {
        "enabled": true
      }
    },
    "use_branded_fallbacks": true,
    "minimum_publishable_assets": 3
  },
  "voice": {
    "enabled": true,
    "quality_mode": "best_available",
    "keep_only_selected_audition": true,
    "routes": [
      {
        "provider": "pocket_tts",
        "model": "alba",
        "languages": [
          "en"
        ]
      },
      {
        "provider": "kokoro",
        "model": "af_heart",
        "languages": [
          "en"
        ]
      },
      {
        "provider": "piper",
        "model": "en_US-lessac-medium.onnx",
        "languages": [
          "en"
        ]
      },
      {
        "provider": "openai_tts",
        "model": "gpt-4o-mini-tts:coral",
        "languages": [
          "en",
          "fr",
          "ar"
        ]
      }
    ],
    "sample_rate": 24000,
    "catalog": {
      "kokoro": [
        "af_heart",
        "af_bella",
        "af_nicole",
        "af_sarah",
        "af_sky",
        "am_adam",
        "am_michael",
        "bf_emma",
        "bm_george"
      ],
      "pocket_tts": [
        "alba",
        "anna",
        "azelma",
        "bill_boerst",
        "caro_davy",
        "charles",
        "cosette",
        "eponine",
        "eve",
        "fantine",
        "george",
        "jane",
        "jean",
        "javert",
        "marius",
        "mary",
        "michael",
        "paul",
        "peter_yearsley",
        "stuart_bell",
        "vera",
        "estelle",
