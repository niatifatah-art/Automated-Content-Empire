        "shimmer",
        "verse",
        "marin",
        "cedar"
      ]
    },
    "prepare_tts_script": true,
    "verify_actual_voice": true
  },
  "render": {
    "default_mode": "both",
    "renderer": "ffmpeg",
    "preview_resolution": "720p",
    "final_resolution_vertical": "1080x1920",
    "final_resolution_landscape": "1920x1080",
    "four_k_enabled": false,
    "burn_subtitles": true,
    "reject_empty_renders": true,
    "branded_fallback_visuals": true,
    "validate_after_render": true
  },
  "hardware": {
    "profile": "balanced_cpu",
    "reserve_system_ram_gb": 4,
    "prefer_cpu_inference": true,
    "gpu_acceleration": "auto"
  },
  "product": {
    "name": "Automated Content Empire",
    "version": "1.7.0"
  },
  "interaction": {
    "default_mode": "assisted",
    "ask_only_when_relevant": true,
    "show_progress": true
  },
  "automation": {
    "default_mode": "assisted",
    "candidates": 5,
    "selection": "automatic",
    "maximum_retries": 3,
    "output": "both",
    "pause_on_critical_fact_failure": true,
    "required_extras_by_type": {
      "youtube.short": [
        "title",
        "description",
        "tags",
        "thumbnail"
      ],
      "tiktok.short": [
        "caption",
        "hook",
        "thumbnail"
      ],
      "instagram.reel": [
        "caption",
        "thumbnail"
      ],
      "facebook.reel": [
        "caption",
        "thumbnail"
      ],
      "x.video_script": [
        "post"
      ],
      "linkedin.video_script": [
        "post"
      ]
    }
  },
  "quality": {
    "minimum_score": 85,
    "reject_stage_directions": true,
    "reject_unverified_statistics": true,
    "reject_empty_or_duplicate_candidates": true,
    "tts_forbidden_patterns": [
      "[INTRO]",
      "[OUTRO]",
      "HOST:",
      "NARRATOR:"
    ],
    "media": {
      "require_audio_when_voice_requested": true,
      "reject_black_frame_ratio_above": 0.92,
      "reject_silent_audio": true
    }
  },
  "completion_contracts": {
    "video_short": [
      "script",
      "quality",
      "tts_script",
      "narration",
      "visual_track",
      "subtitles",
      "editing_plan",
      "final_validation"
    ],
    "video_long": [
      "script",
      "quality",
      "tts_script",
      "narration",
      "visual_track",
      "subtitles",
      "editing_plan",
      "final_validation"
    ],
    "text": [
      "content",
      "quality"
    ],
    "image_brief": [
      "content",
      "quality"
    ]
  }
}
