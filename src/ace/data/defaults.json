{
  "schema_version": 5,
  "version": "2.1.0",
  "execution": {
    "cloud_first": true,
    "allow_degraded_local": false,
    "automatic_local_fallback": false,
    "minimum_quality_score": 85,
    "maximum_retries": 2,
    "maximum_cost_per_generation_usd": 1.0,
    "cache_enabled": true
  },
  "credentials": {
    "gemini": {
      "maximum_credentials": 2,
      "environment_variables": [
        "GEMINI_API_KEY_PRIMARY",
        "GEMINI_API_KEY_BACKUP",
        "GEMINI_API_KEY"
      ],
      "retry_before_failover": 1,
      "cooldown_seconds": 60,
      "respect_retry_after": true
    }
  },
  "providers": {
    "gemini": {
      "enabled": true,
      "type": "gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "cost_tier": "free_or_paid",
      "cloud": true
    },
    "openai": {
      "enabled": false,
      "type": "openai_compatible",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "cloud": true,
      "cost_tier": "paid"
    },
    "openrouter": {
      "enabled": false,
      "type": "openai_compatible",
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "cloud": true,
      "cost_tier": "mixed"
    },
    "ollama": {
      "enabled": true,
      "type": "ollama",
      "base_url": "http://127.0.0.1:11434",
      "cloud": false,
      "cost_tier": "local"
    }
  },
  "routes": {
